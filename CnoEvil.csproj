  <!-- Unity Mono reads .mdb, not Windows .pdb: convert so stack traces show file and line. Developer only, not for release zips. -->
  <Target Name="MakeMdb" AfterTargets="Build" Condition="Exists('$(TargetDir)$(TargetName).pdb') And Exists('$(BepInExDir)\Mono.Cecil.Mdb.dll')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Tools\pdb2mdb.ps1&quot; -Assembly &quot;$(TargetPath)&quot; -CecilDir &quot;$(BepInExDir)&quot; -SearchDirs &quot;$(ManagedDir);$(BepInExDir)&quot;" ContinueOnError="true" />
  </Target>

  <Target Name="CopyToPlugins" AfterTargets="MakeMdb" Condition="Exists('$(GameDir)\BepInEx\plugins')">
    <MakeDir Directories="$(PluginsDir)" Condition="!Exists('$(PluginsDir)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginsDir)" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath).mdb" DestinationFolder="$(PluginsDir)" ContinueOnError="true" Condition="Exists('$(TargetPath).mdb')" />
    <Delete Files="$(PluginsDir)\$(TargetName).pdb" ContinueOnError="true" />
  </Target>
